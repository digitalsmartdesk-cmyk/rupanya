{
  "name": "storefronts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "brands/*"
  ],
  "scripts": {
    "dev:rupanya": "npm run dev -w brands/rupanya",
    "dev:navsaaj": "npm run dev -w brands/navsaaj",
    "dev:lalitya": "npm run dev -w brands/lalitya",
    "dev:blush-layers": "npm run dev -w brands/blush-layers",
    "build:rupanya": "npm run build -w brands/rupanya",
    "build:navsaaj": "npm run build -w brands/navsaaj",
    "build:lalitya": "npm run build -w brands/lalitya",
    "build:blush-layers": "npm run build -w brands/blush-layers",
    "build:all": "npm run build:rupanya && npm run build:navsaaj && npm run build:lalitya && npm run build:blush-layers"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
